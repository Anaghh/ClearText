<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClearText" Width="1320" Height="850" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="14"
        Background="{DynamicResource Canvas}" Foreground="{DynamicResource Ink}">
  <Window.Resources>
    <SolidColorBrush x:Key="Canvas" Color="#F3F5FA"/>
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Ink" Color="#202B40"/>
    <SolidColorBrush x:Key="Muted" Color="#68758B"/>
    <SolidColorBrush x:Key="Line" Color="#E4E9F2"/>
    <SolidColorBrush x:Key="Hover" Color="#E9EFF9"/>
    <SolidColorBrush x:Key="Accent" Color="#3866E9"/>
    <SolidColorBrush x:Key="AccentText" Color="#3866E9"/>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="10"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
        <Grid Background="Transparent"><Track Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True">
          <Track.DecreaseRepeatButton><RepeatButton Name="Decrease" Command="ScrollBar.PageUpCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
          <Track.Thumb><Thumb Margin="2" Background="{DynamicResource Line}"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{TemplateBinding Background}" CornerRadius="3" MinHeight="10" MinWidth="5"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
          <Track.IncreaseRepeatButton><RepeatButton Name="Increase" Command="ScrollBar.PageDownCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
        </Track></Grid>
        <ControlTemplate.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="10"/><Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/><Setter TargetName="Decrease" Property="Command" Value="ScrollBar.PageLeftCommand"/><Setter TargetName="Increase" Property="Command" Value="ScrollBar.PageRightCommand"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="13,9"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="Chrome" Property="BorderThickness" Value="2"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{DynamicResource Accent}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.85"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderThickness" Value="2"/><Setter TargetName="Chrome" Property="BorderBrush" Value="#86B7FF"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="RailButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Foreground" Value="#DEE7FB"/><Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Margin" Value="0,3"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="7" Padding="14,11"><ContentPresenter HorizontalAlignment="Left"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#273956"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#8CAEFF"/><Setter TargetName="Chrome" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="Background" Value="{DynamicResource Surface}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="SelectionBrush" Value="#9BB8FF"/>
      <Setter Property="CaretBrush" Value="{DynamicResource Ink}"/>
    </Style>
    <Style TargetType="ToggleButton">
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="Padding" Value="12,7"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border x:Name="Chrome" CornerRadius="6" Padding="{TemplateBinding Padding}" Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Hover}"/><Setter Property="Foreground" Value="{DynamicResource AccentText}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Hover}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="Chrome" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabChrome" Margin="0,0,4,0" CornerRadius="8,8,0,0" Background="Transparent" Padding="15,11"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabChrome" Property="Background" Value="{DynamicResource Surface}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabChrome" Property="Background" Value="{DynamicResource Hover}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Grid Background="{DynamicResource Canvas}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="184"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#152238" Grid.RowSpan="2">
      <Grid Margin="14,25,14,18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="12,0,0,32">
          <Border Width="38" Height="38" Background="#5985FF" CornerRadius="11" HorizontalAlignment="Left"><TextBlock Text="C" FontSize="26" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <TextBlock Text="ClearText" FontSize="22" FontWeight="SemiBold" Foreground="White" Margin="0,14,0,3"/>
          <TextBlock Text="ROOM TO THINK." FontSize="9" FontWeight="SemiBold" Foreground="#91A3C1"/>
        </StackPanel>
        <StackPanel Grid.Row="1">
          <TextBlock Text="WORKSPACE" Foreground="#8498B8" FontSize="10" FontWeight="SemiBold" Margin="14,0,0,12"/>
          <Button Name="NewButton" Style="{StaticResource RailButton}" Content="＋  New document" ToolTip="New document (Ctrl+N)"/>
          <Button Name="OpenButton" Style="{StaticResource RailButton}" Content="↗  Open files" ToolTip="Open one or more files (Ctrl+O)"/>
          <Button Name="PracticeButton" Style="{StaticResource RailButton}" Content="◇  Practice space"/>
          <Button Name="MapButton" Style="{StaticResource RailButton}" Content="≡  Reading map" ToolTip="Headings and bookmarks"/>
        </StackPanel>
        <StackPanel Grid.Row="3">
          <Border BorderBrush="#2B3A52" BorderThickness="0,1,0,0" Margin="10,0,10,15"/>
          <Button Name="ThemeButton" Style="{StaticResource RailButton}" Content="◐  Switch theme"/>
          <TextBlock Text="PRIVATE BY DEFAULT" Foreground="#91A3C1" FontSize="9" Margin="14,18,0,5"/>
          <TextBlock Text="Local files. No cloud." Foreground="#B3C0D5" FontSize="11" Margin="14,0,0,15"/>
          <TextBlock Text="0.3.0 · Windows preview" Foreground="#8498B8" FontSize="10" Margin="14,0,0,0"/>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="28,24,28,0">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions>
      <Grid Margin="0,0,0,24">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="A QUIETER WAY TO READ" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Muted}"/><TextBlock Text="Your words, in focus." FontSize="27" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Name="TutorialButton" Content="Quick start  F1" Margin="0,0,10,0"/>
          <Button Name="SaveButton" Content="Save document" Style="{StaticResource Primary}" ToolTip="Save (Ctrl+S)"/>
        </StackPanel>
      </Grid>
      <Grid Grid.Row="1" Margin="0,0,0,15">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <ToggleButton Name="FocusButton" Content="Focus lens" Margin="0,0,5,0" ToolTip="Dim surrounding text and follow the current paragraph"/>
          <ToggleButton Name="WrapButton" Content="Word wrap" IsChecked="True" ToolTip="Fit long lines to the window"/>
          <ToggleButton Name="ReadOnlyButton" Content="Read only" Margin="5,0,0,0" ToolTip="Prevent edits in this tab"/>
          <Border Background="{DynamicResource Line}" Width="1" Height="18" Margin="14,0"/>
          <Button Name="SmallerButton" Content="A−" Padding="10,6" ToolTip="Smaller text"/>
          <TextBlock Name="FontLabel" Text="15" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" FontSize="12" Margin="5,0"/>
          <Button Name="LargerButton" Content="A＋" Padding="10,6" ToolTip="Larger text"/>
          <Button Name="FontButton" Content="Sans" Padding="10,6" ToolTip="Cycle coordinated reading fonts: Sans, Book, Code"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Name="FindButton" Content="Find  Ctrl+F" Padding="10,6"/><Button Name="MoreButton" Content="•••" FontWeight="Bold" Padding="12,6" ToolTip="More document actions"/></StackPanel>
      </Grid>
      <Border Name="SearchPanel" Grid.Row="2" Background="{DynamicResource Surface}" CornerRadius="8" Padding="12" Margin="0,0,0,14" Visibility="Collapsed">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBox Name="SearchBox" ToolTip="Search this document; Enter finds next" AutomationProperties.Name="Find text"/>
          <TextBlock Name="SearchStatus" Grid.Column="1" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" Margin="12,0"/>
          <Button Name="FindNextButton" Grid.Column="2" Content="Find next ↓"/>
          <Button Name="CloseSearchButton" Grid.Column="3" Content="✕" ToolTip="Close search"/>
        </Grid>
      </Border>
      <Grid Grid.Row="3">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Name="GuideColumn" Width="300"/></Grid.ColumnDefinitions>
        <TabControl Name="Documents" BorderThickness="0" Background="Transparent">
          <TabControl.Template><ControlTemplate TargetType="TabControl"><Grid KeyboardNavigation.TabNavigation="Local"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><TabPanel IsItemsHost="True"/></ScrollViewer><Border Grid.Row="1" Background="{DynamicResource Surface}" CornerRadius="0,10,10,10" BorderBrush="{DynamicResource Line}" BorderThickness="1"><ContentPresenter ContentSource="SelectedContent"/></Border></Grid></ControlTemplate></TabControl.Template>
        </TabControl>
        <Border Name="GuidePanel" Grid.Column="1" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Margin="20,0,0,0" Padding="23">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid><TextBlock Text="A LITTLE GUIDANCE" Foreground="{DynamicResource AccentText}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Name="HideGuideButton" Content="✕" HorizontalAlignment="Right" Padding="4" ToolTip="Hide tutorial (F1)"/></Grid>
            <StackPanel Grid.Row="1" Margin="0,20,0,18"><TextBlock Name="StepLabel" Foreground="{DynamicResource Muted}" FontSize="11"/><ProgressBar Name="GuideProgress" Height="3" Maximum="6" Value="1" Margin="0,10,0,0" BorderThickness="0" Background="{DynamicResource Line}" Foreground="{DynamicResource AccentText}"/></StackPanel>
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel><TextBlock Name="GuideTitle" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,15"/><TextBlock Name="GuideCopy" FontSize="13" LineHeight="22" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/><Border Background="{DynamicResource Canvas}" CornerRadius="8" Padding="13" Margin="0,20,0,0"><TextBlock Name="GuideTip" FontSize="12" Foreground="{DynamicResource AccentText}" TextWrapping="Wrap" LineHeight="19"/></Border></StackPanel>
            </ScrollViewer>
            <StackPanel Grid.Row="3" Margin="0,20,0,0"><Button Name="GuidePracticeButton" Content="Open practice document" Background="{DynamicResource Hover}" Padding="10,11"/><Grid Margin="0,15,0,0"><Button Name="GuideBackButton" Content="← Back" HorizontalAlignment="Left"/><Button Name="GuideNextButton" Content="Next →" HorizontalAlignment="Right" Style="{StaticResource Primary}"/></Grid></StackPanel>
          </Grid>
        </Border>
        <Border Name="MapPanel" Grid.Column="1" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Margin="20,0,0,0" Padding="23" Visibility="Collapsed">
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid><TextBlock Text="YOUR READING MAP" Foreground="{DynamicResource AccentText}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Name="HideMapButton" Content="✕" HorizontalAlignment="Right" Padding="4" ToolTip="Hide reading map"/></Grid>
            <StackPanel Grid.Row="1" Margin="0,23,0,20"><TextBlock Text="Find your way&#10;back." FontSize="24" FontWeight="SemiBold"/><TextBlock Text="A map of your document, and the moments you want to keep." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="13" LineHeight="21" Margin="0,12,0,0"/></StackPanel>
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><StackPanel>
              <TextBlock Text="DETECTED HEADINGS" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" Margin="0,0,0,10"/>
              <ListBox Name="OutlineList" Background="Transparent" Foreground="{DynamicResource Ink}" BorderThickness="0" FontSize="13" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
              <TextBlock Name="OutlineHint" Text="Headings appear here as you write. Try # Chapter one or an ALL CAPS title." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="12" LineHeight="20" Margin="0,8,0,24"/>
              <TextBlock Text="BOOKMARKS" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" Margin="0,15,0,10"/>
              <ListBox Name="BookmarkList" Background="Transparent" Foreground="{DynamicResource Ink}" BorderThickness="0" FontSize="13" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
              <TextBlock Name="BookmarkHint" Text="Mark a passage to revisit it later. Bookmarks and reading positions are remembered for saved files." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="12" LineHeight="20" Margin="0,8,0,15"/>
            </StackPanel></ScrollViewer>
            <StackPanel Grid.Row="3" Margin="0,20,0,0"><Button Name="BookmarkButton" Content="Bookmark this passage" Style="{StaticResource Primary}" ToolTip="Toggle bookmark at cursor (Ctrl+B)"/><TextBlock Text="Headings are inferred from the text.&#10;No document is uploaded." Foreground="{DynamicResource Muted}" FontSize="11" LineHeight="18" Margin="0,12,0,0"/></StackPanel>
          </Grid>
        </Border>
      </Grid>
      <Grid Grid.Row="4"><TextBlock Name="StatusLeft" FontSize="11" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/><TextBlock Name="StatusRight" FontSize="11" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
    </Grid>
  </Grid>
</Window>
